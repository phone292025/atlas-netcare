APP_NAME="Atlas NetCare"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atlas_netcare
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail — Gmail SMTP
# ---------------------------------------------------------------------------
# FR-102 sends a password reset link by email. It is only a real feature if a
# message actually arrives, so the demo accounts below use real, deliverable
# addresses rather than the @apu.test ones they had until 2026-08-29.
# See docs/04-open-questions.md Q11.
#
# ATLAS_MAIL_ACCOUNT is a Gmail account name WITHOUT @gmail.com. Every line
# below is built from it, and so are the four account addresses further down,
# so pointing your copy at your own Gmail is a one-line change.
#
# Gmail ignores everything after a + in an address, so all four accounts land
# in the one inbox you already own. Nobody has to share a personal address and
# nothing real ends up in the repository.
ATLAS_MAIL_ACCOUNT=your.gmail.name

# MAIL_PASSWORD IS A GOOGLE APP PASSWORD, NOT YOUR GOOGLE PASSWORD.
#   Google Account → Security → 2-Step Verification (has to be ON already)
#     → App passwords → create one named "Atlas NetCare" → paste it below.
# Google displays it as four groups of four. PASTE IT WITHOUT THE SPACES.
#
# Then check it actually works:   php artisan atlas:mail-test
#
# NEVER COMMIT IT. .env is gitignored; this file is not. An app password in
# the repository is a Google account handed to everyone who clones it. If one
# is ever pushed, revoke it on that same App passwords screen — rewriting the
# git history does not help, because the push already happened.
#
# Leaving MAIL_PASSWORD empty is a supported state: the reset screen detects
# it and says so instead of claiming to have sent an email.
# `log` by default, NOT smtp.
#
# Real delivery needs a Google app password, which is a key to a personal
# Google account and can never be committed. Nobody cloning this can send mail
# without setting one up, so shipping smtp with an empty password meant a
# reviewer clicking "forgot password" got "we could not send the email" and a
# dead end.
#
# With `log`, Laravel writes the whole message into storage/logs/laravel.log.
# The link is real and it works. To follow it:
#
#     php artisan atlas:reset-link
#
# FR-102 is then demonstrable on a fresh clone with no mail account at all.
# Switch to smtp and paste an app password when you want it to really send.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="${ATLAS_MAIL_ACCOUNT}@gmail.com"
MAIL_PASSWORD=

# Gmail refuses to send as an address the account does not own, so the From
# address is the account itself and cannot be anything else.
MAIL_FROM_ADDRESS="${ATLAS_MAIL_ACCOUNT}@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Atlas NetCare
# See docs/07-data-strategy.md and docs/05-architecture.md
# ---------------------------------------------------------------------------

# Where access point telemetry comes from.
#   simulated = generated locally (default; no external dependency)
#   snmp      = polled from real access points (needs APU IT access)
# Switching drivers requires no code changes outside app/Services/Telemetry.
ATLAS_TELEMETRY_DRIVER=simulated

# When true, DemoDataSeeder runs and populates demo assets, telemetry and
# tickets, all tagged is_demo. Set false for a clean deployable system.
ATLAS_DEMO_MODE=true

# Seconds between dashboard refreshes. See ADR-0005.
ATLAS_POLL_INTERVAL=20

# The lowest ticket priority that alerts every engineer the moment a person
# raises it: low, medium or critical. Leave empty to switch the alert off.
ATLAS_NEW_TICKET_ALERT_FROM=critical

# The first administrator, created by ReferenceSeeder. Atlas NetCare has no
# self-registration, so somebody has to create the first account.
# CHANGE THE PASSWORD before running `php artisan migrate --seed` on anything
# that is not your own machine, and change it again after first sign-in.
# ---------------------------------------------------------------------------
# Sign-in addresses
# ---------------------------------------------------------------------------
# These are LOGIN IDENTIFIERS. Nothing is sent to them, and they never have to
# be deliverable, so a fresh clone can sign in without owning any mailbox.
#
# They deliberately do NOT derive from ATLAS_MAIL_ACCOUNT. They used to, which
# meant anybody cloning this got "your.gmail.name+admin@gmail.com" on the login
# screen: it works, and it reads like a mistake.
#
# IF YOU WANT THE PASSWORD RESET TO ACTUALLY DELIVER (FR-102), point these at
# real addresses instead. Gmail ignores everything after a +, so one mailbox
# covers all four and no teammate has to share a personal address:
#
#   ATLAS_ADMIN_EMAIL="${ATLAS_MAIL_ACCOUNT}+admin@gmail.com"
#   ATLAS_DEMO_ENGINEER_EMAIL="${ATLAS_MAIL_ACCOUNT}+engineer@gmail.com"
#
# Changing one of these on a database that is already seeded gives you a
# SECOND account, not a renamed one. Both seeders match on email.
ATLAS_ADMIN_NAME="System Administrator"
ATLAS_ADMIN_EMAIL=admin@atlas.local

# DELIBERATELY BLANK. Set your own before seeding.
#
# This shipped as ChangeMeNow!2026, which meant the highest privilege account
# in the system was created with a password printed in a public repository, on
# every clone and in CI. 11-installation-guide.md already said "there is
# deliberately no default" — the file disagreed with its own documentation.
#
# ReferenceSeeder refuses to create the administrator while this is empty and
# tells you so, which is the behaviour that message was written for.
ATLAS_ADMIN_PASSWORD=

# Demo accounts, created by DemoDataSeeder — one sign-in per role, so the
# engineer and assistant screens can actually be opened. They exist only while
# ATLAS_DEMO_MODE=true, are tagged is_demo, and are removed by
# `php artisan atlas:purge-demo-data`. Not for a real deployment.
#
# CHANGING ONE OF THESE ADDRESSES ON A DATABASE THAT ALREADY HAS THEM gives
# you a SECOND account, not a renamed one — both seeders match on email. If
# you already ran the seeders with the old @apu.test addresses, rename the
# existing rows rather than reseeding, or you will be signing in as a user
# that owns none of the tickets and shifts.
ATLAS_DEMO_PASSWORD=AtlasDemo!2026
ATLAS_DEMO_ENGINEER_NAME="Yar Zar Min"
ATLAS_DEMO_ENGINEER_EMAIL=engineer@atlas.local
ATLAS_DEMO_ASSISTANT_NAME="Swan Yee Htet"
ATLAS_DEMO_ASSISTANT_EMAIL=assistant.one@atlas.local
ATLAS_DEMO_ASSISTANT2_NAME="Nyan Lin Tun"
ATLAS_DEMO_ASSISTANT2_EMAIL=assistant.two@atlas.local
