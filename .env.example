APP_NAME="Atlas NetCare"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL in the Docker stack (compose.yaml), as seen from this machine.
# Inside the stack, compose.yaml sets DB_HOST=db instead.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=atlas
DB_USERNAME=atlas
# Required: compose.yaml refuses to start without it. Set a long random one
# before the first start, for example the output of
#   php -r "echo bin2hex(random_bytes(16));"
DB_PASSWORD=

# Daily database backups into ./backups, kept 14 days, by the stack's backup
# service, each one restored into a scratch database to prove it. Remove this
# line to switch them off.
COMPOSE_PROFILES=backup

# A second folder each backup is copied to: another disk, or a network share
# mounted on this machine. A backup on the database's own disk is lost with
# it. Empty: no copy. With APP_ENV=production the app refuses to start
# without one, unless ATLAS_BACKUPS_ELSEWHERE=true says this server is backed
# up some other way.
ATLAS_BACKUP_COPY_DIR=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Atlas sends one kind of email: the password reset link (FR-102).
#
# `log` sends nothing. Laravel writes each message into
# storage/logs/laravel.log, and on a local install with APP_DEBUG=true the
# reset screen shows the link as well. To print the newest one:
#
#     php artisan atlas:reset-link
#
# To send real mail, set MAIL_MAILER=smtp and your mail provider's host,
# port, username, password and from address, then check it with
#
#     php artisan atlas:mail-test
#
# NEVER COMMIT A MAIL PASSWORD. .env is gitignored; this file is not.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@atlas.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Atlas NetCare
# See docs/07-data-strategy.md and docs/05-architecture.md
# ---------------------------------------------------------------------------

# When true, DemoDataSeeder runs and populates demo assets, telemetry and
# tickets, all tagged is_demo. Set false for a clean deployable system.
ATLAS_DEMO_MODE=true

# Seconds between dashboard refreshes. See ADR-0005.
ATLAS_POLL_INTERVAL=20

# The lowest ticket priority that alerts every engineer the moment a person
# raises it: low, medium or critical. Leave empty to switch the alert off.
ATLAS_NEW_TICKET_ALERT_FROM=critical

# Incident alerts on Telegram as well as in the app: a bot token from
# @BotFather. Each person adds their chat id on their profile. Empty, no
# Telegram alerts.
ATLAS_TELEGRAM_BOT_TOKEN=

# With ATLAS_BIND opening the stack to the network, the app refuses to start
# on unsafe settings (debug, demo accounts, plain HTTP). true starts it
# anyway, for a short demonstration on a Wi-Fi you trust. Never in production.
ATLAS_ALLOW_UNSAFE_NETWORK=false

# ---------------------------------------------------------------------------
# Sign-in accounts
# ---------------------------------------------------------------------------
# These addresses are LOGIN IDENTIFIERS. Nothing is sent to them unless mail
# is set up above, so a fresh clone can sign in without owning a mailbox.
#
# The administrator. Atlas NetCare has no self-registration. With
# ATLAS_DEMO_MODE=true, `php artisan db:seed` creates this account with
# ATLAS_DEMO_PASSWORD, like the demo accounts below. On a clean install,
# `php artisan atlas:create-admin` creates it with a random password it shows
# once. There is no separate admin password setting.
ATLAS_ADMIN_NAME="System Administrator"
ATLAS_ADMIN_EMAIL=admin@atlas.local

# Demo accounts, one sign-in per role, created by DemoDataSeeder. They exist
# only while ATLAS_DEMO_MODE=true, are tagged is_demo, and are removed by
# `php artisan atlas:purge-demo-data`, the demo administrator with them.
# ATLAS_DEMO_PASSWORD is public: set your own before anyone else can reach
# the app.
#
# CHANGING AN ADDRESS ON A DATABASE THAT ALREADY HAS THE ACCOUNT gives you a
# SECOND account, not a renamed one: the seeder and atlas:create-admin match
# on email. Rename the existing row instead, or you will be signing in as a
# user that owns none of the tickets and shifts.
ATLAS_DEMO_PASSWORD=AtlasDemo!2026
ATLAS_DEMO_ENGINEER_NAME="Yar Zar Min"
ATLAS_DEMO_ENGINEER_EMAIL=engineer@atlas.local
ATLAS_DEMO_ASSISTANT_NAME="Swan Yee Htet"
ATLAS_DEMO_ASSISTANT_EMAIL=assistant.one@atlas.local
ATLAS_DEMO_ASSISTANT2_NAME="Nyan Lin Tun"
ATLAS_DEMO_ASSISTANT2_EMAIL=assistant.two@atlas.local
