<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>

        <!--
            Pinned, or the suite inherits whatever is in .env. Setting
            ATLAS_TELEMETRY_DRIVER=local there to watch a real network made the
            test run shell out to `ping` for every collection: two tests went
            from milliseconds to 42 seconds each and three more failed, because
            the local driver polls nothing whose is_demo is true and every
            factory-made access point is. A suite whose result depends on an
            untracked file, or on whether the machine has a network, is not a
            suite. Tests that want another driver bind it themselves.
        -->
        <env name="ATLAS_TELEMETRY_DRIVER" value="simulated"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!-- The address atlas:create-admin uses when given none. Pinned so the
             tests never read it from the developer's own .env, which differs
             from one machine to the next. -->
        <env name="ATLAS_ADMIN_EMAIL" value="admin@atlas.test"/>
    </php>
</phpunit>
